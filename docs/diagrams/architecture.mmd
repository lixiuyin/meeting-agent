%% Meeting Agent system architecture. Keep this file synchronized with architecture.md.
%% Source of truth for component boundaries: backend/src/api, backend/src/services,
%% backend/src/core, frontend/nginx.conf, and docker-compose.yaml.

flowchart TB
    Browser["Browser<br/>React SPA"]
    MCPClient["MCP client<br/>Claude Desktop or compatible client"]
    MCPServer["separate src/mcp.py process<br/>FastMCP; six API-backed tools; stdio by default"]

    subgraph Frontend["Frontend container — Nginx :8080<br/>Compose host :8307"]
        SPA["React 19 + TypeScript + Vite<br/>pages · components · hooks · API clients"]
        Nginx["Nginx<br/>static assets · SPA fallback · /api proxy"]
        Nginx -->|serves static bundle| SPA
    end

    Browser -->|same-origin HTTP / SSE / WS| Nginx

    subgraph Backend["Backend container — FastAPI :8000"]
        Middleware["Middleware<br/>request ID · timing · CORS · rate limiting<br/>security headers · API-key verification"]
        RouterHub["/api/v1 router registry<br/>file download first, then meetings, chat, sessions,<br/>memory, health, settings, skills, websocket"]

        subgraph APIs["HTTP and event surfaces"]
            ChatAPI["chat.py<br/>/chat · /chat/stream · /chat/search"]
            MeetingsAPI["meetings/<br/>upload · CRUD · reprocess · transcript<br/>summary · semantics · evidence · speakers · timeline"]
            SessionsAPI["sessions.py<br/>messages · summaries · branches<br/>continuation preview · cite · search"]
            MemoryAPI["memory.py<br/>projects · review · typed facts · changes<br/>CRUD · versions · search · decay · entities"]
            SettingsAPI["settings/<br/>read/update · bindings · rebuilds · reload"]
            HealthAPI["health.py<br/>health · live · ready · traffic · consistency"]
            WebSocketAPI["websocket.py<br/>POST /ws/token · WS /ws"]
            SkillsAPI["skills.py<br/>create · list · match · invoke"]
            FileAPI["file_download.py<br/>assets · file download · signed URLs"]
        end

        subgraph CoreServices["Core service layer"]
            Chain["chain/<br/>ask() · ask_stream()<br/>PipelineContext orchestration"]
            Processor["processor/<br/>upload → extract → index → persist<br/>AV · document · image · text routes"]
            RAG["rag/<br/>chunking · indexing · scope routing<br/>vector · BM25 · multimodal · reranking"]
            Memory["memory/<br/>history · long-term facts · summaries<br/>decay · consolidation · semantic search"]
            KG["knowledge_graph/<br/>entity and relation extraction<br/>SQLite + entity vectors"]
            StreamBus["services/stream_bus.py<br/>bounded SSE event bus<br/>step · token · sources · web_results · trace · done/error"]
            Traffic["traffic_control.py<br/>provider concurrency · rate limits<br/>circuit breakers · fallback state"]
            Jobs["jobs.py + durable_jobs<br/>lease · retry · dedupe · cancel<br/>dead-letter · embedded workers"]
        end

        subgraph Adapters["Provider and integration adapters"]
            LLM["llm/<br/>OpenAI-compatible · Anthropic · Ollama · Azure · others"]
            Embeddings["embedder.py<br/>OpenAI · Ollama · HuggingFace and custom bindings"]
            Transcriber["asr/ + transcriber facade<br/>AssemblyAI<br/>timestamps · diarization"]
            Parser["parser/<br/>Marker · MinerU · Paddle<br/>local profile · quality gates · PDF text fallback"]
            Vision["vision/<br/>image captions and OCR"]
            WebSearch["search.py<br/>DuckDuckGo · SerpAPI · Tavily"]
        end

        subgraph Storage["Persistent data"]
            SQLite["SQLite — data/meetings.db<br/>WAL + migrations<br/>meetings/files · sessions/messages<br/>memories · entities/relations<br/>bm25_index + FTS5 · summary BM25"]
            Chroma["Chroma — data/vectordb<br/>meetings · meeting_summaries<br/>meeting_files_summaries · user_memories<br/>session_summaries · memory_entities"]
            Files["Local filesystem — data/uploads<br/>original files · parsed assets<br/>page images · thumbnails"]
        end

        Lifespan["FastAPI lifespan<br/>Alembic upgrade · recovery · decay<br/>BM25 drift · retention · WAL checkpoint<br/>graceful shutdown"]
        Observability["Observability<br/>structured logs · pipeline traces<br/>Prometheus /metrics · optional OTEL/Sentry"]
        Config["Settings snapshot<br/>main.yaml defaults < .env < process environment"]
    end

    Nginx -->|/api/* proxy + backend API key| Middleware
    Middleware --> RouterHub
    RouterHub --> ChatAPI & MeetingsAPI & SessionsAPI & MemoryAPI & SettingsAPI
    RouterHub --> HealthAPI & WebSocketAPI & SkillsAPI & FileAPI

    ChatAPI --> Chain
    MeetingsAPI --> Jobs & Processor & RAG
    SessionsAPI --> Memory
    MemoryAPI --> Memory & KG
    SettingsAPI --> Config & RAG & Embeddings
    HealthAPI --> Observability
    WebSocketAPI --> StreamBus
    SkillsAPI --> Chain
    FileAPI --> Files

    Chain --> RAG & Memory & KG & WebSearch & LLM & StreamBus & Traffic & Jobs
    Jobs --> Processor & Memory & KG
    Processor --> Transcriber & Parser & Vision & RAG & SQLite & Files
    RAG --> Embeddings & SQLite & Chroma
    Memory --> Embeddings & SQLite & Chroma
    KG --> Embeddings & SQLite & Chroma
    LLM --> Traffic
    Embeddings --> Traffic

    Lifespan --> SQLite & Chroma & Memory & RAG
    Config -. settings .-> Middleware
    Observability -. metrics/logs/traces .-> RouterHub

    MCPClient -->|stdio| MCPServer
    MCPServer -->|HTTP /api/v1| Middleware

    subgraph Providers["External providers — optional and configuration-dependent"]
        LLMProvider["LLM APIs"]
        EmbedProvider["Embedding APIs or local models"]
        ASRProvider["AssemblyAI"]
        ParseProvider["Marker · MinerU · Paddle APIs"]
        SearchProvider["Web search APIs"]
    end
    LLM --> LLMProvider
    Embeddings --> EmbedProvider
    Transcriber --> ASRProvider
    Parser --> ParseProvider
    WebSearch --> SearchProvider

