# Meeting files (user uploads + per-meeting asset directories).
# Use anchored paths (leading "/") so we only ignore root-level data/
# and materials/ (large media payloads from local testing) and don't
# clobber frontend/src/components/materials/ source files.
/data/
/materials/
backend/data/
backend/materials/

