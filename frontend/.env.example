# Meeting Agent Frontend Configuration
# Copy this file to .env and fill in values

# API key used only by the Vite development proxy (leave empty for dev mode).
# Production containers read API_KEY at runtime from the root .env.compose or
# a Kubernetes Secret; the key is never embedded in browser JavaScript.
VITE_API_KEY=

# API base URL (default: /api/v1, which proxies to backend via Vite dev server)
VITE_API_BASE_URL=/api/v1

# Sentry DSN for error monitoring (optional)
VITE_SENTRY_DSN=
