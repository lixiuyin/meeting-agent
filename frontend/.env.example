# Meeting Agent Frontend Configuration
# Copy this file to .env and fill in values

# API Key for backend authentication (leave empty for dev mode)
VITE_API_KEY=

# API base URL (default: /api/v1, which proxies to backend via Vite dev server)
VITE_API_BASE_URL=/api/v1

# Sentry DSN for error monitoring (optional)
VITE_SENTRY_DSN=
