{
  "name": "meeting-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Frontend for Meeting Agent — upload meeting recordings/PDFs/PPTs and ask questions via RAG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lixiuyin/meeting-agent.git",
    "directory": "frontend"
  },
  "bugs": {
    "url": "https://github.com/lixiuyin/meeting-agent/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run bundle:check",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8307 --strictPort",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest",
    "test:run": "vitest --run",
    "e2e": "playwright test",
    "e2e:ci": "playwright test",
    "e2e:full-stack": "E2E_ENVIRONMENT=production E2E_API_KEY=e2e-test-key-primary ../scripts/run-isolated-e2e-smoke.sh e2e/full-stack",
    "e2e:headed": "PLAYWRIGHT_HEADED=1 playwright test --project=chromium",
    "type-check": "tsc --noEmit",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "@sentry/react": "^10.48.0",
    "antd": "^6.3.6",
    "axios": "^1.7.7",
    "framer-motion": "^12.38.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.45",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-intl": "^7.1.14",
    "react-markdown": "^9.0.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.14.1",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-virtuoso": "^4.18.4",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.59.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^10.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.0.2",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
