# Meeting Agent Backend configuration example.
# Copy to .env and fill in real values; empty fields (e.g. *_API_KEY) must be set
# before enabling the corresponding feature.
# Conventions: booleans use true/false; durations use the unit in the suffix
# (_SECONDS / _MINUTES / _DAYS).

# ===== Anthropic prompt cache (Claude) =====
ANTHROPIC_PROMPT_CACHE_ENABLED=true
ANTHROPIC_PROMPT_CACHE_MIN_CHARS=1024

# ===== Backend API auth =====
API_KEY=

# ===== ASR (speech-to-text, default AssemblyAI) =====
ASR_LANGUAGE=en
ASR_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_LANGUAGE_DETECTION=true
ASSEMBLYAI_MAX_WAIT_SECONDS=1800
ASSEMBLYAI_POLL_INTERVAL_SECONDS=3
ASSEMBLYAI_SPEAKER_LABELS=true
ASSEMBLYAI_SPEECH_MODEL=universal-3-pro

# ===== Audio segmentation (semantic boundary / speaker change) =====
AUDIO_SEMANTIC_BOUNDARY_ENABLED=false
AUDIO_SEMANTIC_BOUNDARY_THRESHOLD=0.5
AUDIO_SEMANTIC_MAX_SEGMENTS=20
AUDIO_SEMANTIC_MIN_SEGMENTS=2
AUDIO_SPEAKER_IN_CONTENT=true
AUDIO_SPLIT_ON_SPEAKER_CHANGE=true

# ===== Broad recall cap =====
BROAD_RECALL_MAX_FILES=50

# ===== Chat message retention =====
CHAT_MESSAGE_RETENTION_DAYS=180

# ===== Text chunking (parent / child sizes and overlap) =====
CHILD_CHUNK_OVERLAP=32
CHILD_CHUNK_SIZE=256
CHUNK_OVERLAP=128
CHUNK_SIZE=1024

# ===== Combined extraction (entities / relations / facts) =====
COMBINED_EXTRACTION_ENABLED=true

# ===== Context loading timeout =====
CONTEXT_LOAD_TIMEOUT_S=8.0

# ===== CORS =====
CORS_ORIGINS=

# ===== Memory decay state retention =====
DECAY_STATE_RETENTION_DAYS=365

# ===== Vector distance metric (l2 / cosine / ip) =====
DISTANCE_METRIC=l2

# ===== Document cleanup (header/footer, repetition removal) =====
DOC_CLEAN_HEADER_FOOTER_MAX_LINES=2
DOC_CLEAN_REPETITION_MAX_LINE_LENGTH=120
DOC_CLEAN_REPETITION_MIN_PAGES=3
DOC_CLEAN_REPETITION_MIN_RATIO=0.6

# ===== Embedding service =====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_BINDING=openai
EMBEDDING_DIMENSION=1536
EMBEDDING_HOST=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_QUERY_CACHE_ENABLED=true
EMBEDDING_QUERY_CACHE_SIZE=64
EMBEDDING_STAMPEDE_WAIT_S=0

# ===== Entity context and alias merging =====
ENTITY_ALIAS_MERGE_THRESHOLD=0.85
ENTITY_CONTEXT_MAX_TOKENS=600
ENTITY_RELATIONS_LIMIT=50

# ===== Runtime environment (dev / staging / prod) =====
ENVIRONMENT=dev

# ===== Extraction input budget =====
EXTRACTION_INPUT_MAX_TOKENS=1500
EXTRACTION_MIN_ANSWER_CHARS=50

# ===== Fallback circuit breaker =====
FALLBACK_BREAKER_COOLDOWN_SECONDS=30.0
FALLBACK_BREAKER_THRESHOLD=3

# ===== Per-file summary (broad-recall injection cap and context size) =====
FILE_SUMMARY_BROAD_INJECT_CAP=50
FILE_SUMMARY_CONTEXT_CHARS=1400

# ===== Global memory =====
GLOBAL_MEMORY_LIMIT=3

# ===== Service bind address =====
HOST=0.0.0.0

# ===== Hybrid search (BM25 + vector) =====
HYBRID_ALPHA=0.5
HYBRID_MULTIMODAL_ALPHA=0.5
HYBRID_SEARCH_ENABLED=true

# ===== Knowledge graph =====
KNOWLEDGE_GRAPH_ENABLED=true

# ===== LLM (generation) =====
LLM_API_KEY=
LLM_BASE_URL=
LLM_BINDING=openai
LLM_CACHE_ENABLED=true
LLM_CACHE_MAX_SIZE=512
LLM_CACHE_TTL_SECONDS=300
LLM_CIRCUIT_BREAKER_RECOVERY=60
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CONTEXT_WINDOW=128000
LLM_HISTORY_BUDGET_CHARS=16000
LLM_HOST=
LLM_MAX_CONCURRENCY=10
LLM_MAX_TOKENS=2048
LLM_MODEL=gpt-4o-mini
LLM_PROMPT_RESERVE_TOKENS=500
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RPM=60
LLM_SUPPORTS_VISION=auto
LLM_TEMPERATURE=0.3

# ===== Marker parser (PDF, etc.) =====
MARKER_API_KEY=
MARKER_BASE_URL=https://www.datalab.to/api/v1/marker
MARKER_MAX_WAIT_SECONDS=300

# ===== Upload and parse limits =====
MAX_PARSE_PAGES=1000
MAX_UPLOAD_SIZE_MB=500

# ===== Meeting-level summary =====
MEETING_AUTO_SUMMARIZE_FILES=true
MEETING_SUMMARY_BROAD_INJECT_CAP=20
MEETING_SUMMARY_CONTEXT_CHARS=2800

# ===== Memory system (extraction / clustering / decay / scoring / retention) =====
MEMORY_AUTO_EXTRACT=true
MEMORY_AUTO_EXTRACT_INITIAL_IMPORTANCE=1.0
MEMORY_CLUSTER_THRESHOLD=0.75
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_CONSOLIDATION_MIN_CLUSTER=3
MEMORY_CONSOLIDATION_WINDOW_DAYS=2
MEMORY_CONTEXT_MAX_TOKENS=800
MEMORY_DECAY_ENABLED=true
MEMORY_DECAY_INTERVAL_HOURS=24
MEMORY_DECAY_RATE_PER_DAY=0.01
MEMORY_DEDUP_THRESHOLD=0.75
MEMORY_EXTRACTION_INCLUDE_EXISTING=true
MEMORY_EXTRACTION_MODE=balanced
MEMORY_EXTRACTION_MODEL=
MEMORY_INITIAL_IMPORTANCE=3
MEMORY_MAX_CONTEXT_ITEMS=6
MEMORY_MAX_FACTS_PER_TURN=3
MEMORY_MAX_IMPORTANCE=5
MEMORY_MAX_PER_USER=500
MEMORY_MIN_IMPORTANCE=1
MEMORY_PROFILE_ENABLED=true
MEMORY_PROFILE_REFRESH_INTERVAL=50
# Memory scoring weights (decay / importance / semantic; should sum to 1.0).
MEMORY_SCORING_DECAY_WEIGHT=0.4
MEMORY_SCORING_IMPORTANCE_WEIGHT=0.3
MEMORY_SCORING_SEMANTIC_WEIGHT=0.3
MEMORY_SEARCH_OVERSAMPLE_FACTOR=5
MEMORY_SEMANTIC_CLUSTER_ENABLED=true
MEMORY_TTL_DAYS=90

# ===== MinerU parser =====
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MAX_WAIT_SECONDS=600

# ===== Multimodal (image OCR / caption deduplication) =====
MULTIMODAL_ATTACH_GATE_ENABLED=true
MULTIMODAL_CAPTIONING_ENABLED=true
MULTIMODAL_CAPTION_OCR_DEDUP_ENABLED=true
MULTIMODAL_CAPTION_OCR_DEDUP_TIMEOUT_SECONDS=8.0

# ===== Multi-query rewriting (recall diversity) =====
MULTI_QUERY_COUNT=3
MULTI_QUERY_ENABLED=false

# ===== Non-text chunking strategy (native / semantic) =====
NON_TEXT_CHUNKING_STRATEGY=native

# ===== OCR common config =====
OCR_DPI=300
OCR_LANGUAGE=en
OCR_PROVIDER=marker

# ===== PaddleOCR =====
PADDLEOCR_API_KEY=
PADDLEOCR_BASE_URL=

# ===== Parent-child chunking =====
PARENT_CHILD_ENABLED=false

# ===== Parser HTTP and image limits =====
PARSER_HTTP_TIMEOUT_SECONDS=180.0
PARSER_MAX_IMAGES_PER_PAGE=20
PARSER_MAX_IMAGE_BYTES=8388608
PARSER_POLL_INTERVAL_SECONDS=2.0

# ===== Parse job timeouts (per-MB and absolute cap) =====
PARSE_TIMEOUT_MAX_SECONDS=900
PARSE_TIMEOUT_PER_MB_SECONDS=2
PARSE_TIMEOUT_SECONDS=300

# ===== Per-file summary input budget =====
PER_FILE_SUMMARY_INPUT_MAX_TOKENS=8000

# ===== Service port =====
PORT=8000

# ===== Principal hashing pepper (do not leave empty in production) =====
PRINCIPAL_PEPPER=

# ===== Total prompt budget (history + retrieval + system) =====
PROMPT_TOTAL_BUDGET_TOKENS=12000

# ===== Query rewriting =====
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MODEL=
QUERY_REWRITE_TIMEOUT_SECONDS=10

# ===== RAG-Anything integration (falls back to native RAG when disabled) =====
RAGANYTHING_ENABLED=false
RAGANYTHING_FALLBACK_TO_NATIVE=true
RAGANYTHING_INDEX_TIMEOUT_SECONDS=120
RAGANYTHING_LLM_TIMEOUT_SECONDS=90
RAGANYTHING_QUERY_TIMEOUT_SECONDS=30
RAGANYTHING_WORKING_DIR=

# ===== RAG anchors (context-driven targeted recall) =====
RAG_ANCHOR_BOOST_IN_BROAD_RECALL=true
RAG_ANCHOR_ENABLED=true
RAG_ANCHOR_MAX_IDS=8
RAG_ANCHOR_NARROW_FETCH_MULTIPLIER=5
RAG_ANCHOR_NARROW_FETCH_MULTIPLIER_CASE2=3
RAG_ANCHOR_NARROW_RRF_WEIGHT=0.5
RAG_ANCHOR_ONLY_SCORE_FLOOR_RATIO=0.8
RAG_ANCHOR_QUOTA_RATIO=0.5
RAG_ANCHOR_TTL_MINUTES=30
RAG_ANCHOR_TTL_MODE=fixed

# ===== RAG broad recall (multi-query merge strategy / scope) =====
RAG_BROAD_RECALL_MQ_MERGE=rrf
RAG_BROAD_RECALL_MULTI_QUERY_ENABLED=false
RAG_BROAD_RECALL_SCOPE_CAP=10

# ===== RAG content-type rerank =====
RAG_CONTENT_TYPE_RERANK_ENABLED=true

# ===== RAG fair scheduling (prevent single-file domination) =====
RAG_FAIR_ADAPTIVE_CHUNKS=true
RAG_FAIR_CONCURRENCY=8
RAG_FAIR_SIZE_FACTOR_ENABLED=true

# ===== RAG file-scoping mode (router_and_funnel / router / funnel) =====
RAG_FILE_SCOPING_MODE=router_and_funnel

# ===== RAG funnel (file-level prior + convergent aggregation) =====
RAG_FUNNEL_AGGREGATION=top_k_mean
RAG_FUNNEL_AGGREGATION_ALPHA=0.85
RAG_FUNNEL_AGG_TOP_K=3
RAG_FUNNEL_EVIDENCE_MODE=ratio
RAG_FUNNEL_FETCH_MULTIPLIER=10
RAG_FUNNEL_FILE_PRIOR_CAP=0.3
RAG_FUNNEL_FILE_PRIOR_ENABLED=true
RAG_FUNNEL_FILE_PRIOR_FULL_MATCH_BONUS=0.2
RAG_FUNNEL_FILE_PRIOR_MODE=additive
RAG_FUNNEL_FILE_PRIOR_WEIGHT=0.1
RAG_FUNNEL_MERGE_STRATEGY=rrf
RAG_FUNNEL_MIN_POOL_SIZE=12
RAG_FUNNEL_MULTIMODAL_ENABLED=true
RAG_FUNNEL_NARROW_MIN_EVIDENCE=0.15
RAG_FUNNEL_RRF_K=60
RAG_FUNNEL_TITLE_PRIOR_CAP=0.15
RAG_FUNNEL_TITLE_PRIOR_ENABLED=true
RAG_FUNNEL_TITLE_PRIOR_WEIGHT=0.05
RAG_FUNNEL_TOP_FILES=12
RAG_FUNNEL_TOP_MEETINGS=12
RAG_FUNNEL_WIDE_K_MAX=0
RAG_FUNNEL_WIDE_K_MIN=0

# ===== RAG hierarchical retrieval =====
RAG_HIERARCHICAL_ENABLED=true

# ===== RAG multimodal indexing (images / tables / captions) =====
RAG_IMAGE_OCR_MIN_LENGTH=15
RAG_INDEX_IMAGE_CAPTIONS=true
RAG_INDEX_TABLES=true

# ===== RAG meeting-summary router =====
RAG_MEETING_SUMMARY_ROUTER_ENABLED=true
RAG_MEETING_SUMMARY_ROUTER_MIN_HITS=1
RAG_MEETING_SUMMARY_ROUTER_MIN_SCORE=0.4
RAG_MEETING_SUMMARY_ROUTER_TIMEOUT_S=1.5
RAG_MEETING_SUMMARY_ROUTER_TOP_MEETINGS=15

# ===== RAG minimum chunks per file =====
RAG_MIN_CHUNKS_PER_FILE=3

# ===== RAG index persistence interval =====
RAG_PERSIST_INTERVAL_SECONDS=30

# ===== RAG pre-rerank deduplication =====
RAG_PRE_RERANK_DEDUP_ENABLED=true
RAG_PRE_RERANK_DEDUP_THRESHOLD=0.92

# ===== RAG reranker candidate multiplier =====
RAG_RERANK_FETCH_MULTIPLIER=6

# ===== RAG retriever implementation (e.g. native) =====
RAG_RETRIEVER_PROVIDER=native

# ===== RAG sibling-chunk co-retrieval =====
RAG_SIBLING_CORETRIEVE_ENABLED=true
RAG_SIBLING_CORETRIEVE_MAX_TOTAL=4
RAG_SIBLING_CORETRIEVE_PER_ANCHOR=1

# ===== RAG speaker filter (push down to vector layer) =====
RAG_SPEAKER_FILTER_PUSHDOWN=false

# ===== RAG file-level summary router (complements chunk recall) =====
RAG_SUMMARY_ROUTER_ENABLED=true
RAG_SUMMARY_ROUTER_FALLBACK_TO_CHUNK=true
RAG_SUMMARY_ROUTER_HYBRID_ALPHA=0.6
RAG_SUMMARY_ROUTER_HYBRID_ENABLED=true
RAG_SUMMARY_ROUTER_MIN_SCORE=0.0
RAG_SUMMARY_ROUTER_TOP_FILES=12

# ===== Reranker =====
RERANKER_API_KEY=
RERANKER_BASE_URL=https://openrouter.ai/api/v1
RERANKER_BATCH_SIZE=200
RERANKER_BINDING=cohere
RERANKER_MIN_SCORE=0.15
RERANKER_MODEL=cohere/rerank-4-pro
RERANKER_SCOPED_MIN_SCORE=0.1
RERANKER_TIMEOUT_SECONDS=30.0
RERANKER_TOP_N=20
RERANKER_UNSCOPED_MIN_SCORE=0.05

# ===== Coreference resolver (history-aware) =====
RESOLVER_ENABLED=true
RESOLVER_HISTORY_TOKEN_BUDGET=1500
RESOLVER_HISTORY_TURNS=3
RESOLVER_TIMEOUT_S=4.0

# ===== RRF merge parameter =====
RRF_K_PARAM=60

# ===== Scoped memory (per meeting / session isolation) =====
SCOPED_MEMORY_STRICT=false

# ===== Retrieval score threshold (vector distance) =====
SCORE_THRESHOLD=1.5

# ===== Web search (default Exa) =====
SEARCH_API_KEY=
SEARCH_BINDING=exa
SEARCH_MAX_RESULTS=5
SEARCH_REGION=wt-wt
SEARCH_TIMEOUT=10

# ===== Security response headers =====
SECURITY_CSP=default-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
SECURITY_FRAME_OPTIONS=DENY
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin

# ===== Semantic chunking =====
SEMANTIC_CHUNKING_ENABLED=false
SEMANTIC_EMBED_TIMEOUT_S=15.0

# ===== Session context and history summarization =====
SESSION_CONTEXT_MAX_TOKENS=800
SESSION_CONTEXT_SKIP_THRESHOLD=3
SESSION_MAX_HISTORY=50
SESSION_MAX_TOKENS=4096
SESSION_SUMMARY_ENABLED=true
SESSION_SUMMARY_IDLE_MINUTES=15
SESSION_SUMMARY_MAX_ITEMS=3
SESSION_SUMMARY_MAX_MESSAGES=100
SESSION_SUMMARY_MIN_TURNS=4
SESSION_SUMMARY_STARTUP_BACKFILL=false

# ===== Skill matching and routing =====
SKILL_MATCHING_ENABLED=true
SKILL_MATCH_TIMEOUT_S=15.0
SKILL_ROUTE_TIMEOUT_S=15.0
SKILL_ROUTING_MIN_SIMILARITY=0.35

# ===== Streaming concurrency limit =====
STREAM_CONCURRENT_LIMIT=20

# ===== Summary intent top-K =====
SUMMARY_INTENT_TOP_K=25

# ===== Retrieval top-K (with floor under meeting scope) =====
TOP_K=8
TOP_K_MEETING_SCOPED_FLOOR=16

# ===== Trusted hosts and proxies =====
TRUSTED_HOSTS=
TRUSTED_PROXIES=

# ===== TTS (text-to-speech) =====
TTS_API_KEY=
TTS_BASE_URL=
TTS_BINDING=
TTS_MODEL=
TTS_SPEED=1.0
TTS_VOICE=

# ===== Diversity constraints for unscoped retrieval =====
UNSCOPED_DIVERSITY_ENABLED=true
UNSCOPED_FETCH_MULTIPLIER=4
UNSCOPED_MAX_PER_MEETING=5

# ===== Vector deletion and search timeouts =====
VECTOR_DELETION_MAX_ATTEMPTS=10
VECTOR_SEARCH_TIMEOUT_S=8.0

# ===== Video keyframe extraction =====
VIDEO_KEYFRAMES_ENABLED=false

# ===== Vision model (combined OCR + caption extraction) =====
VISION_API_KEY=
VISION_BASE_URL=
VISION_CAPTION_MIN_CHARS=12
VISION_COMBINED_EXTRACTION_ENABLED=true
VISION_MODEL=
VISION_OCR_MIN_CHARS=6
VISION_RETRY_BASE_DELAY_SECONDS=0.5
VISION_RETRY_MAX_ATTEMPTS=3
VISION_RETRY_MAX_DELAY_SECONDS=2.0

# ===== Web search call timeout =====
WEB_SEARCH_TIMEOUT_S=8.0
