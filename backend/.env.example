# Meeting Agent runtime configuration.
# Advanced RAG, memory, limits, and timeout defaults live in config/main.yaml.

# Core LLM. LLM_API_KEY may be empty only for a local provider.
LLM_BINDING=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=

# Optional role-specific models. Empty extraction model reuses LLM_MODEL.
MEMORY_EXTRACTION_MODEL=
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=
VISION_REASONING_EFFORT=none
VISION_COMBINED_MAX_TOKENS=2048

# Embeddings. Leave EMBEDDING_API_KEY empty to reuse LLM_API_KEY when supported.
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Optional audio transcription.
ASSEMBLYAI_API_KEY=

# Optional document parsers. OCR_PROVIDER selects marker, mineru, or paddleocr.
OCR_PROVIDER=marker
MARKER_BASE_URL=https://www.datalab.to/api/v1/marker
MARKER_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_KEY=
PADDLEOCR_BASE_URL=
PADDLEOCR_API_KEY=

# Optional web search.
SEARCH_BINDING=exa
SEARCH_API_KEY=

# Optional reranking. Leave RERANKER_BINDING empty to disable it.
# For OpenRouter or another Cohere-compatible API, set RERANKER_BINDING=cohere.
# API key: set RERANKER_API_KEY for a separate key, or leave it empty to reuse LLM_API_KEY.
# The key that is used must be valid for RERANKER_BASE_URL.
RERANKER_BINDING=
RERANKER_MODEL=cohere/rerank-4-pro
RERANKER_API_KEY=
RERANKER_BASE_URL=https://openrouter.ai/api/v1

# Deployment security. Set independent secrets for non-development environments.
# PRINCIPAL_ID optionally pins a stable existing principal across API-key rotation;
# for existing data, copy the owned ID from the database instead of inventing one.
ENVIRONMENT=dev
API_KEY=
PRINCIPAL_PEPPER=
PRINCIPAL_ID=
